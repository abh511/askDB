# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your_groq_key_here
# Check the Groq console for current models (Llama 70B was retired; we use gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# The app connects as the read-only user. Admin is only for loading data.
DATABASE_URL=postgresql+psycopg://askdb_reader:reader_pw@localhost:5432/askdb
DATABASE_ADMIN_URL=postgresql+psycopg://askdb_admin:admin_pw@localhost:5432/askdb

CHROMA_DIR=.chroma
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
API_URL=http://localhost:8000
